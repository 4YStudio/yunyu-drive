{
  "name": "yunyu-drive",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "node scripts/tauri.mjs",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:deb": "tauri build --bundles deb",
    "build:deb": "tauri build --bundles deb",
    "build:rpm": "tauri build --bundles rpm",
    "build:linux": "tauri build --bundles deb,rpm",
    "build:windows": "tauri build --bundles nsis",
    "build:mac": "tauri build --bundles app,dmg --target universal-apple-darwin",
    "version:set": "node scripts/set-version.mjs",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-notification": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "qrcode": "^1.5.4",
    "vue": "^3.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6",
    "typescript": "~5.9",
    "vite": "^7",
    "vue-tsc": "^3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "description": "云语聚合网盘 —— 多网盘聚合桌面客户端",
  "license": "GPL-3.0-or-later"
}
