[Desktop Entry]
Type=Application
Name=云语聚合网盘
Comment=夸克 / 移动云盘 / 阿里云盘 / 123 云盘 / 百度网盘 聚合客户端
Exec=yunyu-drive %u
Icon=yunyu-drive
Terminal=false
Categories={{categories}}
StartupWMClass=yunyu-drive
StartupNotify=true
# `yunyu-drive` is our own link form. `qklink` / `qkclouddrive` are what the
# Quark website's 「打开客户端」 button fires — registered here so those clicks
# reach us when we are the quark client.
MimeType=x-scheme-handler/yunyu-drive;x-scheme-handler/qklink;x-scheme-handler/qkclouddrive;
